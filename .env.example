# GoHighLevel inbound webhook for the "Website Leads Intake" workflow.
# Server-only. Do not prefix with NEXT_PUBLIC.
GHL_WEBHOOK_URL=

# reCAPTCHA v3. If RECAPTCHA_SECRET is empty, verification is skipped (dev only).
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Headless WordPress content API base (only if blog option C1 is chosen).
# WP_API_BASE=https://content.lifestyleinterventions.com/wp-json/wp/v2
